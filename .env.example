HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
POSTGRES_DB=audit
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_HOST_PORT=5433
